# Example usage
circle1 <- Circle(radius = 3, x = 0, y = 0)
# Constructor function for the Circle class
Circle <- function(radius, x = 0, y = 0) {
if (!is.numeric(radius) || radius <= 0) {
stop("Radius must be a positive numeric value.")
}
# Create the Circle object
circle_object <- list(radius = radius, x = x, y = y)
# Assign the class "Circle" to the object
class(circle_object) <- "Circle"
# Return the Circle object
return(circle_object)
}
