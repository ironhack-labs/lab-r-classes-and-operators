library(methods)
#Custom S4 class
setClass(
"Rectangle",
slots = list(
length = "numeric",
width = "numeric"
)
)
# The constructor function
Rectangle <- function(length, width) {
# Create a new Rectangle object
new("Rectangle", length = length, width = width)
}
#  The show() method for the Rectangle class
setMethod(
"show",
signature = "Rectangle",
definition = function(object) {
cat("Type: \"Rectangle object\"\n")
cat("Length:", object@length, "\n")
cat("Width:", object@width, "\n")
cat("Area:", object@length * object@width, "\n")
}
)
# Example:
my_rectangle <- Rectangle(length = 4, width = 6)
show(my_rectangle)
#Custom operator
"%==%" <- function(rectangle1, rectangle2) {
if (!inherits(rectangle1, "Rectangle") || (!inherits(rectangle2, "Rectangle"))) {
stop("Both operands must be of class 'Rectangle'.")
}
if (rectangle1@length * rectangle1@width == rectangle2@length * rectangle2@width) {
return(TRUE)
} else {
return(FALSE)
}
}
#Example=
rectangle1 <- Rectangle(length = 4, width = 6)
rectangle2 <- Rectangle(length = 3, width = 8)
rectangle1 %==% rectangle2
