# Define a custom print method for the Circle class
print.Circle <- function(x, ...) {
# Calculate the area of the circle
area <- pi * x$radius^2
# Display the radius and area
cat("Type: \"Circle object\"\n")
cat("Radius:", x$radius, "\n")
cat("Area :", area, "\n")
}
